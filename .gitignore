node_modules
dist
.env
.env.local
*.log
*.p8
.DS_Store
coverage
__pycache__/
.idea
.mcp.json
.reference

# spike build output (the source is kept: it documents why the launcher exists)
scripts/spike-disclaim/fda-probe
scripts/spike-disclaim/*.dSYM

# per-developer Xcode state, not project config
xcuserdata/

# TCC spike build output
scripts/spike-app-tcc/build/

# local app build output. Anchored to the app rather than a bare `.build/`, so it
# cannot quietly swallow a directory of that name elsewhere in the tree.
apps/apple/.build/

# wrangler local state, and the local secrets file. `.dev.vars` holds the Stripe
# keys and the licence signing key in plain text — the same secret that, leaked,
# lets anyone mint licences.
.dev.vars
.dev.vars.*
# Not a wrangler convention — nothing reads it automatically, which is the point.
# It is the staging area for live credentials between creating them in Stripe and
# pushing them with `pnpm secrets:prod`, and it holds the one secret that is shown
# exactly once: the live webhook signing secret.
.prod.vars
.prod.vars.*
.wrangler/

# Screenshot pipeline output. Regenerated by `make screenshots` on every run.
#
# Deliberately NOT apps/website/src/assets/shots/ — the site imports those at
# build time, so they are committed (via LFS) exactly like the icon PNGs the
# site derives. Ignoring them would break `astro build` on any clone that has
# not just run a capture, CI included.
apps/apple/Screenshots/source/
apps/apple/Screenshots/appstore/
apps/apple/Screenshots/diff/
apps/apple/Vendor/

# Internal planning, not for a public repo.
marketing/

# The Sparkle update-signing private key, if it is ever exported from the
# keychain again for CI. Committing it would hand anyone who can read this repo
# the ability to ship a signed update to an app holding Full Disk Access.
*.pem
