---
/**
 * One line glyph per surface, drawn here rather than taken from Apple.
 *
 * **These are deliberately not the real app icons.** Apple's guidelines for
 * third-party use of its trademarks and copyrights do not permit shipping
 * Mail's, Notes', Reminders' or Calendar's artwork in someone else's marketing
 * material, and SF Symbols is licensed for apps on Apple platforms — not for a
 * web page. Downloading four `.icns` files out of `/System/Applications` and
 * serving them from `public/` would be redistributing Apple artwork from a
 * domain that says "unofficial, not affiliated with Apple" three lines below.
 *
 * The app is the place where the real icons belong and where they are used:
 * `SurfaceIcon.swift` asks `NSWorkspace` for each app's icon at runtime, which
 * redistributes nothing and is what every macOS app does. Do not mirror that
 * here by exporting them.
 *
 * So these are generic objects — an envelope, a ruled page, a checklist, a date
 * grid — on one 20-unit grid, one stroke weight, `currentColor` throughout.
 * They read as a set, which the real icons emphatically do not.
 *
 * The prop takes `Surface["id"]`, which is generated from `surfaces.json`, so a
 * surface added to the manifest typechecks here before it has artwork — and
 * renders an empty frame rather than failing the build. Draw the glyph when the
 * surface reaches `SURFACES`; an id with no branch below is one that is in the
 * manifest but not yet on this page.
 */
import type { Surface } from "../data/surfaces";

export interface Props {
  id: Surface["id"];
  size?: number;
  class?: string;
}

const { id, size = 18, class: className } = Astro.props;
---

<svg
  viewBox="0 0 20 20"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="1.4"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class:list={className}
  style={`width:${size}px;height:${size}px`}
>
  {
    id === "mail" && (
      <>
        <rect x="2.5" y="4.75" width="15" height="10.5" rx="2.5" />
        <path d="M4 7 9.1 10.7a1.5 1.5 0 0 0 1.8 0L16 7" />
      </>
    )
  }
  {
    id === "notes" && (
      <>
        <rect x="4" y="2.5" width="12" height="15" rx="2.5" />
        <path d="M4 6.75h12M7.25 10.25h5.5M7.25 13.5h3.5" />
      </>
    )
  }
  {
    id === "reminders" && (
      <>
        <circle cx="5.75" cy="7" r="1.75" fill="currentColor" stroke="none" />
        <circle cx="5.75" cy="13" r="1.75" />
        <path d="M9.75 7h5M9.75 13h5" />
      </>
    )
  }
  {
    id === "contacts" && (
      <>
        {/* A person card: a head and shoulders inside a bounded record, which is
            what an address book entry is. Not Apple's silhouette. */}
        <rect x="2.5" y="3.5" width="15" height="13" rx="3" />
        <circle cx="10" cy="8.75" r="2.15" />
        <path d="M6.4 13.9a3.9 3.9 0 0 1 7.2 0" />
      </>
    )
  }
  {
    id === "messages" && (
      <>
        {/* A speech bubble with a reply tail: a conversation, not Apple's
            green balloon. The two lines are message text, unequal because a
            transcript is not a paragraph. */}
        <path d="M17 11.25a4.25 4.25 0 0 1-4.25 4.25H8.5L4.5 18v-2.9A4.25 4.25 0 0 1 3 11.25v-3.5A4.25 4.25 0 0 1 7.25 3.5h5.5A4.25 4.25 0 0 1 17 7.75Z" />
        <path d="M6.9 8.4h6.2M6.9 11.4h3.9" />
      </>
    )
  }
  {
    id === "maps" && (
      <>
        {/* A folded paper map with a pin — the generic object, not Apple's
            artwork. Three panels from the two fold lines, on the same grid and
            stroke weight as the rest of the set. */}
        <path d="M2.5 5.5 7 3.75l6 2.25 4.5-1.75v10.25L13 16.25 7 14 2.5 15.75Z" />
        <path d="M7 3.75V14M13 6v10.25" />
      </>
    )
  }
  {
    id === "safari" && (
      <>
        {/* A compass rose in a ring — the idea Safari's icon is built on, drawn
            as two triangles rather than as its needle. Not Apple's dial. */}
        <circle cx="10" cy="10" r="7.5" />
        <path d="M13.1 6.9 8.8 8.8 6.9 13.1l4.3-1.9Z" />
      </>
    )
  }
  {
    id === "calendar" && (
      <>
        <rect x="2.5" y="4.25" width="15" height="13.25" rx="2.5" />
        <path d="M2.5 8.25h15M6.75 2.5v3.25M13.25 2.5v3.25" />
        <circle cx="6.9" cy="12.4" r="1.15" fill="currentColor" stroke="none" />
      </>
    )
  }
  {
    id === "screen" && (
      <>
        {/* A display with a smaller frame inside it: the surface captures a
            WINDOW, not the screen, and the glyph should not promise otherwise.
            Same grid and stroke weight as the rest of the set. */}
        <rect x="2.5" y="3.75" width="15" height="11" rx="2" />
        <path d="M7.25 17.25h5.5M10 14.75v2.5" />
        <rect x="5.75" y="6.5" width="7" height="5.25" rx="1" />
      </>
    )
  }
</svg>
