---
/**
 * Apple's mark, for the Download buttons.
 *
 * It says what "Download for macOS" says, in the space before the words: this
 * is a Mac app, from the only place a Mac app comes from. The sibling sites
 * (r2-explorer, d1-explorer) carry the same glyph on the same button, which is
 * the point — four products, one shelf.
 *
 * Sized by the `width`/`height` attributes rather than a `style` or a Tailwind
 * `w-4`, so it comes out right with no CSS applied at all. An unsized SVG in a
 * flex button does not fall back to something small; it fills the button.
 *
 * `fill="currentColor"`: the glyph is a letterform here, not artwork. It
 * inherits the colour of whatever button it sits in, which is what lets the
 * same component sit on the accent fill and on a secondary outline without a
 * variant.
 *
 * The optical nudge is deliberate. The mark's stem sits high in its own box, so
 * a glyph baselined with the label reads as floating; `-mt-px` puts it back.
 */
interface Props {
  size?: number;
  class?: string;
}

const { size = 15, class: className } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="currentColor"
  aria-hidden="true"
  class:list={["-mt-px flex-none", className]}
>
  <path
    d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"
  ></path>
</svg>
