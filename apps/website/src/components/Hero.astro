---
import { DOWNLOAD, HOSTS, PRICING, REPO_URL, SHIPPED, TRIAL } from "../config";
import Button from "./Button.astro";
import FdaPane from "./FdaPane.astro";

/** Each one is a section further down, so the strip is a table of contents. */
const CLAIMS = [
  { label: "one grant", href: "#permissions" },
  { label: "writes off by default", href: "#tools" },
  { label: "every call visible", href: "#activity" },
  { label: "four surfaces", href: "#surfaces" },
] as const;
---

<section class="relative overflow-hidden pt-[88px] pb-[72px]">
  <!-- The icon's own sky, bled off the top edge. The only large use of the
       gradient on the page; everywhere else the accent is a single hue. -->
  <div
    class="pointer-events-none absolute inset-x-0 -top-[200px] h-[680px]"
    style="background:radial-gradient(58% 68% at 50% 0%,rgba(242,137,92,.26) 0%,rgba(242,137,92,.05) 46%,transparent 72%)"
    aria-hidden="true"
  >
  </div>

  <div class="wrap relative grid grid-cols-1 items-center gap-14 lg:grid-cols-[1.05fr_1fr]">
    <div class="flex flex-col gap-6">
      {
        !SHIPPED && (
          <div class="flex items-center gap-2 self-start rounded-full border border-rule-2 bg-bg-2 py-[5px] pr-3.5 pl-2.5">
            <span
              class="block rounded-full bg-accent"
              style="width:6px;height:6px"
              aria-hidden="true"
            />
            <span class="mono !text-fg-dim">Pre-release · not shipped yet</span>
          </div>
        )
      }

      <h1
        class="m-0 font-display text-[clamp(38px,5.6vw,64px)] leading-[1.02] font-semibold tracking-[-0.045em] text-balance"
      >
        Four apps hold your whole disk.<br /><span class="text-accent">It should be one.</span>
      </h1>

      <p class="m-0 max-w-[52ch] text-[16.5px] leading-[1.62] text-pretty text-fg-dim">
        Cupertino is a menu-bar app that lets Claude read Mail, Notes, Reminders and Calendar on your Mac.
        Full Disk Access is a single, indivisible grant — so give it to one signed app instead of to
        every editor that happens to spawn a server.
      </p>

      {/* The grant is the strongest argument and it was, until now, the only one
          above the fold. A reader who bounces here should have seen that this is
          a permission story AND a control story: the other three are what the
          app does once it holds the grant, and each has its own section below. */}
      <ul class="m-0 flex list-none flex-wrap gap-x-2.5 gap-y-2 p-0">
        {
          CLAIMS.map((c) => (
            <li>
              <a
                href={c.href}
                class="mono block rounded-full border border-rule-2 px-3 py-[5px] transition-colors hover:border-fg-muted hover:!text-fg-dim"
              >
                {c.label}
              </a>
            </li>
          ))
        }
      </ul>

      {/* Download leads HERE and Buy leads in the closing plate, deliberately.
          A reader at the top has been told the grant argument and nothing else;
          the honest next step for them is the trial, which costs them nothing
          and answers the only question they actually have — does this work
          against MY mail. By the closing plate they have read the latency
          numbers, the write gate and the price ladder, and the order flips.
          The nav carries the price at both ends for whoever skipped ahead. */}
      <div class="flex flex-wrap items-center gap-3">
        {
          SHIPPED ? (
            <>
              {/* Not external: this is a download, and a tab that opens only to
                  close itself is worse than no tab. */}
              <Button href={DOWNLOAD.href}>Download for macOS</Button>
              <Button href={PRICING.buy} variant="secondary">
                Buy a licence <span class="text-fg-dim">·</span> {PRICING.price}
              </Button>
            </>
          ) : (
            <>
              <Button href={REPO_URL} external>
                Watch the repo →
              </Button>
              <Button href="#run" variant="secondary">
                Run it from source
              </Button>
            </>
          )
        }
      </div>

      <div class="flex flex-col gap-1.5">
        {
          SHIPPED && (
            <p class="mono m-0">
              {DOWNLOAD.requires} · {TRIAL.minutes}-minute trial, no account · {PRICING.refundDays}-day
              refund
            </p>
          )
        }
        <p class="mono m-0">MIT servers · unofficial, not affiliated with Apple</p>
      </div>
    </div>

    <!-- The before/after. Four grants collapsing to one, in the pane the reader
         has actually seen.

         Stacked below `sm`: a row of "Visual Studio Code" plus its toggle has a
         min-content width of roughly 205px, so two panes side by side cannot
         fit a phone however hard flex-1 tries — they simply push the page wider
         than the viewport. -->
    <div class="flex flex-col items-stretch gap-4 sm:flex-row sm:items-center sm:gap-6">
      <FdaPane
        rows={HOSTS}
        caption={`${HOSTS.length} grants · ${HOSTS.length} whole disks`}
        class="sm:flex-1"
      />
      <span class="flex-none self-center text-[20px] text-fg-muted" aria-hidden="true">
        <span class="sm:hidden">↓</span><span class="hidden sm:inline">→</span>
      </span>
      <FdaPane
        rows={["Cupertino"]}
        caption="1 grant · every host"
        branded
        tone="ok"
        class="sm:flex-1 sm:self-start"
      />
    </div>
  </div>
</section>
