---
import { SPELLED } from "../config";
import { NOT_STARTED, SURFACES, toolCount } from "../data/surfaces";
import SectionHeader from "./SectionHeader.astro";
import SurfaceGlyph from "./SurfaceGlyph.astro";

/**
 * Counted from the data. This heading used to hard-code "Four" — and note the
 * capital: `SPELLED` is lower-case because its other callers use it mid-sentence,
 * so a heading has to capitalise it rather than render "five surfaces."
 */
const spelled = SPELLED[SURFACES.length] ?? String(SURFACES.length);
const heading = `${spelled[0]?.toUpperCase()}${spelled.slice(1)} surfaces.<br />One bundle.`;
---

<section id="surfaces" class="wrap scroll-mt-20 py-[96px]">
  <SectionHeader eyebrow="Surfaces" heading={heading}>
    Each surface is its own npm package, so a host loads only the tools it wants — and write tools
    against Mail and against Reminders are not the same risk. They share one bundle and one grant,
    which is the whole reason they live together.
  </SectionHeader>

  <div class="reveal grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-5">
    {
      SURFACES.map((s) => (
        <article class="flex flex-col gap-4 rounded-[16px] border border-rule bg-bg-2 p-6 sm:p-7">
          <div class="flex items-center justify-between gap-3">
            <div class="flex items-center gap-2.5">
              {/* Our own glyph, never Apple's icon — see SurfaceGlyph.astro. */}
              <span class="flex size-8 shrink-0 items-center justify-center rounded-[9px] border border-rule-2 bg-bg text-accent">
                <SurfaceGlyph id={s.id} />
              </span>
              <h3 class="m-0 font-display text-[22px] font-semibold tracking-[-0.03em] text-fg">
                {s.name}
              </h3>
            </div>
            <span class="mono !text-accent">{toolCount(s)} tools</span>
          </div>

          <p class="m-0 text-[14px] leading-[1.6] text-pretty text-fg-dim">{s.pitch}</p>

          <div class="mt-auto flex flex-col gap-2.5 pt-2">
            <div class="flex items-center gap-2 text-[12.5px] text-fg-muted">
              <span class="font-mono text-fg-dim">{s.read.length}</span> always registered
              <span class="text-rule-2">·</span>
              <span class="font-mono text-fg-dim">{s.write.length}</span> write-gated
            </div>
            <code class="font-mono text-[11.5px] break-all text-fg-muted">{s.pkg}</code>
          </div>
        </article>
      ))
    }
  </div>

  <div class="reveal mt-5 grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-5">
    {
      SURFACES.map((s) => (
        <p class="m-0 text-[13px] leading-[1.6] text-fg-muted">
          <span class="text-fg-dim">{s.name} without the grant — </span>
          {s.withoutGrant}
        </p>
      ))
    }
  </div>

  <p class="reveal mt-8 border-t border-rule pt-6 text-[14px] text-fg-muted">
    {
      NOT_STARTED.map((n) => (
        <span>
          <span class="text-fg-dim">{n.name}</span> is not started — {n.why}, so it is the one
          surface that cannot ship without Full Disk Access at all.
        </span>
      ))
    }
  </p>
</section>
