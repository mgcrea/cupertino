---
/**
 * The real app, photographed — five of the six captures.
 *
 * The sixth, `surface`, is promoted into `SurfacePane.astro` one scroll below
 * the hero. The drawings this section exists to be checked against all sit
 * above it, so something photographic has to come before them; that shot is the
 * one, because it is the pane where the Apple apps are the subject. What is
 * left here is what earns a slot this far down: the log twice, the connection
 * list, the settings window and the write gate — panes a reader wants after the
 * page has made its argument, not before.
 *
 * Everything else on this page that looks like macOS is drawn in HTML —
 * `Activity.astro`, `MenuBar.astro`, `Status.astro` — and each of those is
 * drawn on purpose: they show a surface a capture cannot photograph at all (a
 * menu-bar dropdown is a high-layer panel, not an ordinary window), or they
 * need to reflow on a phone in a way an image cannot. This section is the other
 * half of that: the window as it actually renders, so a reader can check the
 * drawings against it.
 *
 * The images are NOT hand-placed. `make screenshots` captures them from a real
 * build in demo mode, gates them against committed goldens, and writes them
 * into src/assets/shots — which that command CLEARS on every run. Do not park
 * anything else in that directory, and do not edit these files: the next
 * capture overwrites them. To change what a shot shows, change the fixture in
 * apps/apple/Cupertino/DemoSeed.swift.
 *
 * Imported through astro:assets rather than referenced out of public/, for two
 * reasons: these are 2240px PNGs that would otherwise ship unoptimised, and a
 * missing capture then fails `astro build` outright instead of building clean
 * and 404ing in production.
 */
import { Picture } from "astro:assets";
import activityShot from "../assets/shots/activity.png";
import connectionsShot from "../assets/shots/connections.png";
import promptShot from "../assets/shots/prompt.png";
import settingsShot from "../assets/shots/settings.png";
import writesShot from "../assets/shots/writes.png";
import SectionHeader from "./SectionHeader.astro";

/**
 * The captions are deliberately NOT the ones in
 * apps/apple/Screenshots/screenshots.config.json. That file captions the framed
 * store-shaped visuals, which are read alone and out of context; here the
 * section header has already said what the app is, so these say what each
 * particular pane answers. The two rot separately and should.
 */
/**
 * `id` is the capture's name; the anchor it becomes is prefixed `shot-`.
 *
 * `Activity.astro` further up owns the bare `#activity`, and the hero's "every
 * call visible" chip points at it. Unprefixed, these put a duplicate id in the
 * page and made that anchor ambiguous — which nothing caught, because nothing
 * links to them: they are deep links for a reader sharing one shot, not
 * navigation.
 */
const shots = [
  {
    image: promptShot,
    id: "prompt",
    title: "One question, end to end",
    body: "The same pane as below, seeded with a single turn: “What did I promise Marie last week, and is any of it on my calendar?” Contacts leads, because the question names a person and every other surface is addressed by handle.",
    alt: "Cupertino's log showing one turn: a Contacts search, two Mail calls and a Calendar range query, all reads.",
  },
  {
    image: activityShot,
    id: "activity",
    title: "The log, live",
    body: "The same pane again, this time across everything a working day sends at it. Tool, prompt and resource names with the arguments each was called with — message contents and results stay off unless you ask for them — and a refused write shows up as a refusal.",
    alt: "Cupertino's activity log: timestamped calls across mail, notes, reminders and calendar, with a refused write to Reminders in red.",
  },
  {
    image: connectionsShot,
    id: "connections",
    title: "Every session, ungrouped",
    body: "One row per connection, because each client opens one per server it is wired to — and a client you have run several times over opens several. Three clients is eighteen rows here, and this is the pane that shows them.",
    alt: "Cupertino's connections pane: eighteen live sessions from claude-ai, claude-code and cursor-vscode across mail, notes, reminders and calendar.",
  },
  {
    image: settingsShot,
    id: "settings",
    title: "Wired into your editor, not inside it",
    body: "Claude Desktop, Cursor, LM Studio and Windsurf are configured with one click. Claude Code, VS Code and Codex keep their config in formats this app will not rewrite — JSONC, TOML, and a file holding API credentials that running sessions write to — so those get a line to paste instead. Turn a surface off and the same rows offer the command that takes it back out.",
    alt: "Cupertino's Clients settings: Claude Desktop, Cursor, LM Studio and Windsurf with Reveal buttons, and Claude Code, Visual Studio Code and Codex CLI with copyable commands, above a Project folders section.",
  },
  {
    image: writesShot,
    id: "writes",
    title: "Writes are a separate switch",
    body: "The Mail pane from the top of the page, on a surface with writes off. Notes reports seven tools where Mail reports twenty: the mutating tools, and the prompts that end in one, are not registered at all. An agent is not refused — it is never told they exist.",
    alt: "Cupertino's Notes pane with Allow writes unchecked, its capabilities card reading seven tools, one prompt and three resources, and Safari dimmed in the sidebar as a switched-off surface.",
  },
] as const;

/**
 * Every plate is rendered at the SAME pixel scale, which is not what `w-full`
 * on its own gives you.
 *
 * Five of these are the main window at 2240px; `settings` is the Settings
 * window, which is genuinely a smaller window and comes out of the capture at
 * 2000. Stretched to a shared column width it rendered about 12% larger than
 * the others — same traffic lights, same 13pt type, visibly bigger — and a set
 * of screenshots at two scales reads as two applications.
 *
 * So the column is 1120 CSS px for the widest capture and each other plate
 * takes its share of that, centred. `sizes` has to follow, or the browser picks
 * a candidate for a width the image is never rendered at.
 *
 * Ported from bastion, which hit the same thing with a 1520px Settings window.
 * It derives everything from the imported image's own width, so a capture that
 * changes size needs no second edit here.
 */
const COLUMN = 1120;
const widest = Math.max(...shots.map((shot) => shot.image.width));

const plate = (image: (typeof shots)[number]["image"]) => {
  const share = image.width / widest;
  const css = Math.round(COLUMN * share);
  return {
    style: `max-width:${css}px`,
    widths: [Math.round(css * 0.65), css, css * 2],
    sizes: `(min-width: 1180px) ${css}px, ${Math.round(share * 100)}vw`,
  };
};
---

<section id="screens" class="wrap scroll-mt-20 py-[96px]">
  <SectionHeader eyebrow="The app" heading="A window, not<br />a background process.">
    Cupertino runs as a menu-bar app you can open. That is the point of holding the servers in one
    signed process rather than spawning them inside whichever editor asked first: there is something
    to look at, and it tells you what happened.
  </SectionHeader>

  <div class="flex flex-col gap-14">
    {
      shots.map(({ image, id, title, body, alt }) => (
        <figure id={`shot-${id}`} class="reveal m-0 scroll-mt-24">
          {/* Widths are the rendered CSS widths, not the source's: the plate is
              drawn at `css` and the largest candidate is its 2x. avif then webp,
              with the PNG as the fallback the <picture> keeps. */}
          <Picture
            src={image}
            alt={alt}
            widths={plate(image).widths}
            sizes={plate(image).sizes}
            formats={["avif", "webp"]}
            fallbackFormat="png"
            style={plate(image).style}
            class="mx-auto block h-auto w-full rounded-[14px] border border-rule-2 shadow-[0_24px_60px_-34px_rgba(0,0,0,.9)]"
          />
          <figcaption class="mt-5 grid grid-cols-1 gap-2 lg:grid-cols-[1fr_1.15fr] lg:gap-16">
            <h3 class="m-0 font-display text-[20px] font-semibold tracking-[-0.03em] text-fg">
              {title}
            </h3>
            <p class="m-0 text-[14.5px] leading-[1.65] text-pretty text-fg-dim">{body}</p>
          </figcaption>
        </figure>
      ))
    }
  </div>
</section>
