---
import { APP_VERSION, DOWNLOAD, PRICING, REPO_URL, SHIPPED } from "../config";
import Button from "./Button.astro";
import Logo from "./Logo.astro";

const links = [
  { href: "/#permissions", label: "Permissions" },
  { href: "/#latency", label: "Latency" },
  { href: "/#surfaces", label: "Surfaces" },
  { href: "/#tools", label: "Tools" },
  { href: "/#pricing", label: "Price" },
];
---

<header
  class="sticky top-0 z-50 border-b border-rule bg-[color-mix(in_srgb,var(--color-bg)_72%,transparent)] backdrop-blur-[20px] backdrop-saturate-[180%]"
>
  <div class="wrap flex h-[58px] items-center justify-between gap-6">
    <div class="flex flex-none items-center gap-2.5">
      <a href="/" class="flex items-center gap-[10px] text-fg">
        <Logo size={23} />
        <span class="font-display text-[14.5px] leading-none font-[590] tracking-[-0.02em]"
          >Cupertino</span
        >
      </a>

      {/* The shipping version, beside the wordmark rather than in the button
          cluster: it is an identifying detail like the mark itself, not a call
          to action, and that cluster is already the whole funnel at every
          width. It links to the releases list, which is where the number leads
          anyway — someone reading it wants the notes for it or the build
          itself, and both are on that one page.

          Gated on SHIPPED for the reason config.ts gives: before a release
          there is no version to name. Hidden below `sm`, where the wordmark and
          the price button already fill the bar. `hidden` is safe here because
          this is a plain anchor, not a `Button` — see the note below. */}
      {
        SHIPPED && (
          <a
            href={DOWNLOAD.releases}
            target="_blank"
            rel="noopener"
            class="hidden rounded-full border border-rule px-2 py-[3px] font-mono text-[10.5px] leading-none font-medium text-fg-muted transition-colors hover:border-accent hover:text-accent-hi sm:block"
          >
            {APP_VERSION}
          </a>
        )
      }
    </div>

    {/* `lg`, not `md`. At 768 there is room for the lockup, the version pill and
        two buttons, but not for five links as well — the Buy button was pushed
        off the right edge, which is the worst kind of breakage because nothing
        looks wrong until you go looking for the button. 1024 is where the links
        and the buttons both fit, and it is also where GitHub appears, so the
        whole right-hand cluster arrives at once. Found on bastion, which wraps
        rather than overflows and so showed it sooner. */}
    <nav class="hidden items-center gap-[30px] lg:flex">
      {
        links.map((l) => (
          <a href={l.href} class="text-[13px] text-fg-dim transition-colors hover:text-accent-hi">
            {l.label}
          </a>
        ))
      }
    </nav>

    {/* The bar is the only element that survives a scroll, so it carries the
        whole funnel: try it, or buy it. Three buttons do not fit a phone, so
        they drop in order of how replaceable they are — GitHub is also in the
        footer and the Status table, Download is also in the closing plate, and
        the price is the one thing with nowhere else to be at every scroll
        position. It carries the figure rather than the word "Buy" alone,
        because a price shown before the click is the same honesty the pricing
        section below is built on. */}
    {/* The responsive hiding is on a wrapper rather than on the button itself,
        and has to stay there. `Button` sets `inline-flex`, and Tailwind emits
        `.inline-flex` AFTER `.hidden` in the utilities layer — so `hidden` on
        the button loses to its own base class and the button shows at every
        width. Same specificity, later wins; nothing about it is visible in the
        markup. */}
    <div class="flex flex-none items-center gap-2">
      {
        SHIPPED ? (
          <>
            <span class="hidden lg:block">
              <Button href={REPO_URL} external variant="quiet" size="sm">
                GitHub <span class="opacity-60">↗</span>
              </Button>
            </span>
            <span class="hidden sm:block">
              <Button href={DOWNLOAD.href} variant="secondary" size="sm">
                Download
              </Button>
            </span>
            <Button href={PRICING.buy} size="sm">
              Buy <span class="opacity-70">·</span> {PRICING.price}
            </Button>
          </>
        ) : (
          <Button href={REPO_URL} external variant="quiet" size="sm">
            GitHub <span class="opacity-60">↗</span>
          </Button>
        )
      }
    </div>
  </div>
</header>
