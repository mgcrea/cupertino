---
import { BUNDLE_ID, DOCS, ISSUES_URL, REPO_URL, SIBLING_APP } from "../config";
import Logo from "./Logo.astro";
import MagentaMark from "./MagentaMark.astro";

const columns = [
  {
    title: "Docs",
    links: [
      { label: "Distribution", href: DOCS.distribution },
      { label: "Licensing", href: DOCS.licensing },
      { label: "Envelope Index", href: DOCS.envelopeIndex },
      { label: "Notes phase-0", href: DOCS.notes },
    ],
  },
  {
    title: "Source",
    links: [
      { label: "GitHub ↗", href: REPO_URL },
      { label: "Issues", href: ISSUES_URL },
    ],
  },
  {
    title: "Project",
    links: [
      { label: "Support", href: "/support/" },
      { label: "Feedback", href: "/feedback/" },
      { label: "Privacy", href: "/privacy" },
    ],
  },
  /**
   * The sibling. A column of its own rather than a line inside "Source",
   * because the three above all name parts of Cupertino and this does not —
   * and because this footer renders on every page, which is the whole reason
   * the cross-link lives down here as well as on the homepage.
   */
  {
    title: "More apps",
    links: [{ label: `${SIBLING_APP.name} ↗`, href: SIBLING_APP.url }],
  },
] as const;
---

<footer class="border-t border-rule py-12">
  <div class="wrap grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr_1fr_1fr]">
    <div class="flex flex-col gap-3">
      <div class="flex items-center gap-2.5">
        <Logo size={22} />
        <span class="font-display text-[14.5px] font-[590] tracking-[-0.02em] text-fg"
          >Cupertino</span
        >
      </div>
      <p class="m-0 text-[12.5px] leading-[1.6] text-fg-muted">
        Unofficial. Not affiliated with Apple.<br />
        <code class="font-mono">{BUNDLE_ID}</code> · MIT
      </p>
      {/* The publisher, in the one form every mgcrea site now uses. This footer
          named no publisher at all until here — "Unofficial" says who it is NOT
          affiliated with, which is not the same as saying who made it. */}
      <a
        href="https://mg-crea.com"
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-1.5 text-[12.5px] text-fg-muted transition-colors hover:text-accent-hi"
      >
        <MagentaMark size={13} uid="footer" />Magenta Creations
      </a>
    </div>

    {
      columns.map((c) => (
        <div class="flex flex-col gap-3">
          <div class="mono">{c.title}</div>
          <ul class="m-0 flex list-none flex-col gap-2 p-0">
            {c.links.map((l) => (
              <li>
                <a
                  href={l.href}
                  target="_blank"
                  rel="noopener"
                  class="text-[13px] text-fg-dim transition-colors hover:text-accent-hi"
                >
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</footer>
