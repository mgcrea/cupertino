---
/**
 * The repeated section opener: an accent eyebrow over a display heading, with
 * body copy beside it. The heading is passed as HTML so a section can place its
 * own emphasis.
 */
export interface Props {
  eyebrow: string;
  heading: string;
  id?: string;
  class?: string;
}

const { eyebrow, heading, id, class: className } = Astro.props;
---

<div
  id={id}
  class:list={[
    "mb-[42px] grid grid-cols-1 items-end gap-8 lg:grid-cols-[1fr_1.15fr] lg:gap-16",
    className,
  ]}
>
  <div class="flex flex-col gap-[14px]">
    <div class="mono text-accent">{eyebrow}</div>
    <h2
      class="m-0 font-display text-[clamp(32px,4.2vw,50px)] leading-[1.05] font-semibold tracking-[-0.038em] text-balance"
      set:html={heading}
    />
  </div>
  <p class="m-0 text-[15.5px] leading-[1.68] text-pretty text-fg-dim lg:mb-1">
    <slot />
  </p>
</div>
