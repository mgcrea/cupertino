---
import { DOWNLOAD, PRICING, REPO_URL, SHIPPED, TRIAL } from "../config";
import Button from "./Button.astro";
import Logo from "./Logo.astro";
---

<section id="run" class="wrap scroll-mt-20 py-[96px]">
  <div
    class="reveal relative overflow-hidden rounded-[20px] border border-rule bg-bg-2 px-6 py-14 text-center sm:px-12"
  >
    <div
      class="pointer-events-none absolute inset-x-0 top-0 h-[220px]"
      style="background:radial-gradient(50% 100% at 50% 0%,rgba(242,137,92,.18) 0%,transparent 70%)"
      aria-hidden="true"
    >
    </div>

    <div class="relative flex flex-col items-center gap-6">
      <Logo size={64} />

      <h2
        class="m-0 font-display text-[clamp(28px,3.6vw,42px)] leading-[1.1] font-semibold tracking-[-0.04em] text-balance"
      >
        One app. One grant.
      </h2>

      {
        SHIPPED ? (
          <>
            <p class="m-0 max-w-[46ch] text-[15.5px] leading-[1.65] text-pretty text-fg-dim">
              Signed with a Developer ID and notarized by Apple. One payment covers every 1.x
              release, on every Mac you own — or run every surface for {TRIAL.minutes} minutes first
              and decide afterwards.
            </p>

            {/* The hero's order, reversed. A reader who has arrived here has been
                through the latency numbers, the write gate and the price, so the
                open question is no longer "does this work" but "is it worth
                $14.99" — and the button that answers it should be the filled one.
                Download stays one click away rather than one scroll back up. */}
            <div class="flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
              <Button href={PRICING.buy} size="lg" class="w-full sm:w-auto">
                Buy a licence <span class="opacity-70">·</span> {PRICING.price}
              </Button>
              {/* Not external: this is a download, and a tab that opens only to
                  close itself is worse than no tab. */}
              <Button
                href={DOWNLOAD.href}
                variant="secondary"
                size="lg"
                class="w-full sm:w-auto"
              >
                Download for macOS
              </Button>
            </div>

            <code class="rounded-lg border border-rule bg-bg-3 px-4 py-2.5 font-mono text-[12.5px] text-fg-muted">
              {DOWNLOAD.cask}
            </code>

            <p class="m-0 text-[12.5px] text-fg-muted">
              {DOWNLOAD.requires} · {PRICING.refundDays}-day refund ·{" "}
              <a class="underline underline-offset-2 hover:text-fg-dim" href={DOWNLOAD.checksum}>
                SHA-256
              </a>{" "}
              ·{" "}
              <a class="underline underline-offset-2 hover:text-fg-dim" href={DOWNLOAD.releases}>
                release notes
              </a>
            </p>
          </>
        ) : (
          <>
            <p class="m-0 max-w-[46ch] text-[15.5px] leading-[1.65] text-pretty text-fg-dim">
              The signed app and the npm packages ship together. Until then, clone it and point your
              host at the built CLIs.
            </p>

            <Button href={REPO_URL} external size="lg">
              Watch the repo →
            </Button>

            <code class="rounded-lg border border-rule bg-bg-3 px-4 py-2.5 font-mono text-[12.5px] text-fg-muted">
              git clone mcp-cupertino && pnpm build
            </code>
          </>
        )
      }
    </div>
  </div>
</section>
