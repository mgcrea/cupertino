---
/**
 * The surface Cupertino shows uninvited. It is drawn rather than captured
 * because a menu-bar dropdown is a high-layer panel that `appshot` cannot
 * photograph — it only takes ordinary windows — and because this strip has to
 * reflow on a phone, which an image cannot.
 *
 * It used to be the first product shot on the page, and it is neither the first
 * nor the only one now. `SurfacePane.astro` sits directly above with a real
 * capture of the main window, and `Screens.astro` carries five more further
 * down — so a reader arrives here having just seen the thing this is a drawing
 * of. Keep it honest against them: the row list is built from `Surface.all`,
 * the same table the app's sidebar uses.
 *
 * Beside it, one exchange in a host: the two tools a real question actually
 * calls, with their measured timings and the lane each one came off.
 *
 * Both numbers are measured and both are 97 ms, which looks like a typo and is
 * not. Mail's is the Envelope Index (docs/mail-body.md — "the 97 ms the index
 * lane already costs for subject and sender"); Notes' is a bulk `plaintext`
 * fetch filtered in JS over Apple Events (docs/notes.md — 69 hits over 249,719
 * chars). Two lanes, same answer, which is the whole point of having two.
 *
 * This block previously showed Notes at 41 ms and captioned both calls as the
 * index lane. The 41 was in no document anywhere, and the caption contradicted
 * the Surfaces section below, which correctly says Notes needs no grant at all
 * to search. Numbers here come from docs/ or they do not go here.
 */
import { WIRING } from "../config";
import { SURFACES } from "../data/surfaces";
import Logo from "./Logo.astro";

/**
 * One row per surface: the app builds this menu from `Surface.all`, and each
 * row's trailing caption is its Automation status — `StatusStyle.caption` in
 * SettingsWindow.swift. It is NOT a lane label; the app does not show one here.
 */
const items = SURFACES.map((s) => ({ name: s.name, status: "automation allowed" }));

const calls = [
  { tool: "apple_mail_search_messages", ms: 97, lane: "index" },
  { tool: "apple_notes_search_notes", ms: 97, lane: "events" },
] as const;
---

<section class="wrap grid grid-cols-1 items-start gap-8 pb-[96px] lg:grid-cols-[0.9fr_1.1fr] lg:gap-12">
  <!-- Menu bar + dropdown -->
  <div
    class="reveal overflow-hidden rounded-[14px] border border-rule-2 bg-chrome shadow-[0_24px_60px_-34px_rgba(0,0,0,.9)]"
  >
    <div
      class="flex items-center justify-between gap-4 border-b border-rule-2 bg-chrome-2 px-3.5 py-[7px] text-[11.5px] text-fg-dim"
    >
      <div class="flex items-center gap-3.5">
        <span class="font-semibold text-fg">Claude</span>
        <span class="hidden sm:inline">File</span>
        <span class="hidden sm:inline">Edit</span>
        <span class="hidden sm:inline">View</span>
        <span class="hidden sm:inline">Window</span>
        <span class="hidden sm:inline">Help</span>
      </div>
      <div class="flex items-center gap-2.5">
        <!-- A template image is pure black + alpha; macOS inverts it for a dark
             menu bar, and this strip has to do the same by hand. -->
        <img
          src="/menubar-glyph.svg"
          alt="Cupertino"
          width="14"
          height="14"
          style="filter:invert(1);opacity:.85"
        />
        <span>Thu 09:41</span>
      </div>
    </div>

    <div class="p-2.5">
      <div class="flex items-center gap-2.5 px-2 py-2">
        <Logo size={20} />
        <span class="text-[13px] font-medium text-fg">Cupertino</span>
        <span class="mono ml-auto !text-ok">{items.length} servers running</span>
      </div>

      <ul class="m-0 list-none p-0">
        {
          items.map((i) => (
            <li class="flex items-center gap-2.5 rounded-md px-2 py-[7px] text-[12.5px] text-fg-dim">
              <span
                class="block flex-none rounded-full bg-ok"
                style="width:5px;height:5px"
                aria-hidden="true"
              />
              <span class="text-fg">{i.name}</span>
              <span class="mono ml-auto">{i.status}</span>
            </li>
          ))
        }
      </ul>

      <div class="my-1.5 h-px bg-rule-2"></div>

      <ul class="m-0 list-none p-0 text-[12.5px]">
        <li class="flex items-center gap-2 px-2 py-[7px] text-fg-dim">
          <span class="text-fg">Full Disk Access</span>
          <span class="mono ml-auto !text-ok">granted</span>
        </li>
        <li class="flex items-center gap-2 px-2 py-[7px] text-fg-dim">
          <span class="text-fg">Writes</span>
          <span class="mono ml-auto">off</span>
        </li>
      </ul>

      <div class="my-1.5 h-px bg-rule-2"></div>

      {/* The real menu. It used to read "Copy .mcp.json snippet / Activity… /
          Open diagnostics…", none of which the app has — and Screens.astro now
          sits on the same page showing the actual window, so a reader can hold
          the two side by side. The clients section is the interesting one: it
          writes the config rather than handing over a snippet to paste.

          A subset, via WIRING.mockRows — the real popover lists only the
          clients you have installed, so all seven rows would be less honest
          than three, not more. `command` is empty now that every client is
          written; the branch stays because the shape of that list is not this
          file's decision. */}
      <ul class="m-0 list-none p-0 text-[12.5px] text-fg-dim">
        {
          WIRING.automatic.slice(0, WIRING.mockRows.automatic).map((client) => (
            <li class="flex items-center gap-2 px-2 py-[7px]">
              <span class="text-fg">{client}</span>
              <span class="mono ml-auto !text-ok">configured</span>
            </li>
          ))
        }
        {
          WIRING.command.slice(0, WIRING.mockRows.command).map((client) => (
            <li class="flex items-center gap-2 px-2 py-[7px]">
              <span class="text-fg">{client}</span>
              <span class="mono ml-auto">copy command</span>
            </li>
          ))
        }
      </ul>

      <div class="my-1.5 h-px bg-rule-2"></div>

      <ul class="m-0 list-none p-0 text-[12.5px] text-fg-dim">
        <li class="px-2 py-[7px]">Open Cupertino</li>
        <li class="px-2 py-[7px]">Settings…</li>
        <li class="px-2 py-[7px]">Quit</li>
      </ul>
    </div>
  </div>

  <!-- One exchange -->
  <div class="reveal flex flex-col gap-4 rounded-[14px] border border-rule bg-bg-2 p-6 sm:p-8">
    <div class="mono">claude</div>
    <p class="m-0 text-[19px] leading-[1.45] text-pretty text-fg">
      “What did Anna send me about the lease, and is it in my notes?”
    </p>
    <div class="flex flex-col gap-2">
      {
        calls.map((c) => (
          <div class="flex flex-wrap items-center gap-2.5 rounded-lg border border-rule bg-bg-3 px-3.5 py-2.5">
            <span class="font-mono text-[12px] text-accent">{c.tool}</span>
            <span class="mono ml-auto">
              read · {c.lane} · {c.ms} ms
            </span>
          </div>
        ))
      }
    </div>
    <p class="m-0 text-[13.5px] leading-[1.6] text-fg-muted">
      Two different lanes, and it does not matter which. Mail came off the Envelope Index, because
      asking Mail.app the same thing takes 74 seconds. Notes came off Apple Events, because below
      roughly 5k notes the grant buys nothing there — so it is not asked for.
    </p>
  </div>
</section>
