---
/**
 * The plated squircle mark, served from `public/app-icon.svg` — which
 * `pnpm icons` writes from the repo-root `design/`. There is one rendering, not
 * a small variant: the mark has exactly three generated outputs and inventing a
 * fourth here is how the site's artwork drifted from the app's the first time.
 */
export interface Props {
  size?: number;
  class?: string;
}

const { size = 23, class: className } = Astro.props;
---

<img
  src="/app-icon.svg"
  alt=""
  width={size}
  height={size}
  class:list={className}
  style={`width:${size}px;height:${size}px`}
/>
