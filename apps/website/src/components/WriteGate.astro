---
/**
 * The write gate, made literal: flipping the toggle removes the mutating rows
 * from the document rather than dimming them, because that is what the servers
 * actually do. See `.gate` in global.css and the handler in Layout.astro.
 *
 * Mail is the example because it has the most to lose.
 */
import { SURFACES } from "../data/surfaces";
import SectionHeader from "./SectionHeader.astro";

const mail = SURFACES[0]!;
---

<section id="tools" class="wrap scroll-mt-20 py-[96px]">
  <SectionHeader eyebrow="Tool registration" heading="The list gets shorter,<br />not greyer.">
    The tool list is a pure function of <code class="font-mono text-[14px] text-fg-dim"
      >allowWrites</code
    > and nothing else, because MCP clients cache it. With writes off the mutating tools are never registered
    — the host cannot call what it was never told about, so there is nothing to refuse.
  </SectionHeader>

  <div class="reveal gate rounded-[16px] border border-rule bg-bg-2 p-6 sm:p-8" data-writes="off">
    <div class="mb-6 flex flex-wrap items-center gap-3">
      <code class="font-mono text-[13px] text-fg-dim">APPLE_MAIL_ALLOW_WRITES=</code>
      <div class="flex gap-1.5" role="group" aria-label="Toggle write tools">
        <button
          type="button"
          class="gate-toggle rounded-md border border-rule-2 px-3 py-1.5 font-mono text-[12px] text-fg-dim transition-colors"
          data-value="off"
          data-active="1"
          aria-pressed="true">false</button
        >
        <button
          type="button"
          class="gate-toggle rounded-md border border-rule-2 px-3 py-1.5 font-mono text-[12px] text-fg-dim transition-colors"
          data-value="on"
          data-active="0"
          aria-pressed="false">true</button
        >
      </div>
    </div>

    <div class="grid grid-cols-1 gap-x-10 gap-y-6 sm:grid-cols-2">
      <div>
        <div class="mono mb-3">always registered · {mail.read.length}</div>
        <ul class="m-0 flex list-none flex-col gap-1.5 p-0">
          {
            mail.read.map((t) => (
              <li class="rounded-md border border-rule bg-bg-3 px-3 py-2 font-mono text-[12px] break-all text-fg-dim">
                {t}
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <div class="mono mb-3 !text-accent">
          write-gated · {mail.write.length}
        </div>
        <ul class="m-0 flex list-none flex-col gap-1.5 p-0">
          {
            mail.write.map((t) => (
              <li class="gate-write rounded-md border border-accent/30 bg-[color-mix(in_srgb,var(--color-accent)_9%,transparent)] px-3 py-2 font-mono text-[12px] break-all text-fg">
                {t}
              </li>
            ))
          }
          {/* The counterpart of the rows above: visible only while writes are off. */}
          <li
            class="gate-off rounded-md border border-dashed border-rule-2 px-3 py-2 font-mono text-[12px] text-fg-muted"
          >
            not registered · the host never sees these names
          </li>
        </ul>
      </div>
    </div>
  </div>

  <p class="reveal mt-6 text-[14px] leading-[1.65] text-fg-muted">
    Mutation is one control. On Mail the larger blast radius is <em class="text-fg-dim not-italic"
      >reading</em
    > an entire archive — that is what <code class="font-mono text-[13px] text-fg-dim"
      >*_ACCOUNTS</code
    > is for, and it is enforced in exactly one place so no query path escapes it.
  </p>
</section>
