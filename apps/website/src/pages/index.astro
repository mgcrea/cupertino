---
import Activity from "../components/Activity.astro";
import BodySearch from "../components/BodySearch.astro";
import Cta from "../components/Cta.astro";
import Examples from "../components/Examples.astro";
import Footer from "../components/Footer.astro";
import Grant from "../components/Grant.astro";
import Hero from "../components/Hero.astro";
import Latency from "../components/Latency.astro";
import MenuBar from "../components/MenuBar.astro";
import Nav from "../components/Nav.astro";
import Pricing from "../components/Pricing.astro";
import SafariPages from "../components/SafariPages.astro";
import Screens from "../components/Screens.astro";
import Status from "../components/Status.astro";
import SurfacePane from "../components/SurfacePane.astro";
import Surfaces from "../components/Surfaces.astro";
import ToolMarquee from "../components/ToolMarquee.astro";
import WriteGate from "../components/WriteGate.astro";
import {
  APP_NAME,
  APP_VERSION,
  DOWNLOAD,
  DOCS,
  PRICING,
  REPO_URL,
  SHIPPED,
  SITE_URL,
  SPELLED,
} from "../config";
import { SURFACES, toolCount } from "../data/surfaces";
import Layout from "../layouts/Layout.astro";

const total = SURFACES.reduce((n, s) => n + toolCount(s), 0);

/** Both read from the data. The description used to spell out the four by hand. */
const surfaceList = SURFACES.map((s) => s.name)
  .join(", ")
  .replace(/, ([^,]+)$/, " and $1");
const surfaceCount = SPELLED[SURFACES.length] ?? SURFACES.length;

/**
 * SoftwareApplication rather than Product: nothing is for sale yet, and a price
 * or an offer here would be a structured-data lie. Revisit when SHIPPED flips.
 *
 * `license` names the APP's licence, not the repo's. The subject of this schema
 * is Cupertino, which is source-available; the MIT that used to sit here covers
 * `packages/*` and was the same class of lie the paragraph above warns about.
 * See docs/licensing.md.
 *
 * `downloadUrl` appears only once there is something to download. Announcing one
 * before the first release would put a 404 into search results.
 *
 * `offers` is gated on the same flag and for the same reason. A price in
 * structured data is a claim that the thing can be bought right now; publishing
 * one against a /buy that does not resolve yet would put an unbuyable offer into
 * search results, which is the lie the paragraph at the top is about. Both
 * appear together, at the release, or neither does.
 */
/**
 * Publisher and site identity. `@id` lets the SoftwareApplication schema below
 * point at the same organisation rather than restating it.
 */
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `${SITE_URL}/#organization`,
  name: "Magenta Creations",
  url: "https://mg-crea.com",
  email: "support@mgcrea.io",
  sameAs: ["https://mg-crea.com", "https://github.com/mgcrea"],
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${SITE_URL}/#website`,
  name: APP_NAME,
  url: SITE_URL,
  publisher: { "@id": `${SITE_URL}/#organization` },
  inLanguage: "en",
};

const schema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: APP_NAME,
  applicationCategory: "DeveloperApplication",
  operatingSystem: "macOS 26",
  softwareRequirements: DOWNLOAD.requires,
  url: SITE_URL,
  codeRepository: REPO_URL,
  license: DOCS.appLicense,
  description: `MCP servers for Apple ${surfaceList} — ${total} tools across ${surfaceCount} surfaces — and the signed menu-bar app that holds their one Full Disk Access grant.`,
  author: { "@type": "Person", name: "Olivier Louvignes" },
  ...(SHIPPED
    ? {
        // Alongside downloadUrl on purpose: a softwareVersion is a claim about
        // a build that exists, so it appears exactly when the download does.
        softwareVersion: APP_VERSION,
        downloadUrl: `${SITE_URL}${DOWNLOAD.href}`,
        offers: {
          "@type": "Offer",
          price: PRICING.amount,
          priceCurrency: PRICING.currency,
          url: `${SITE_URL}${PRICING.buy}`,
          availability: "https://schema.org/InStock",
        },
      }
    : {}),
};
---

<Layout schema={[organizationSchema, websiteSchema, schema]}>
  <Nav />
  <main>
    <Hero />
    {/* Directly under the hero: the H1 promises an agent put to work, and this
        is the section that says what that means before the page starts arguing
        about permissions. */}
    <Examples />
    {/* Then the app itself, photographed, before any of the drawn mocks. It
        answers what Examples just asked — here is the thing serving those
        calls — and it is the picture `MenuBar`, `Grant` and `Activity` are
        meant to be checkable against, which only works if it comes first.
        Promoted out of `Screens`, which keeps the other five captures. */}
    <SurfacePane />
    <MenuBar />
    <ToolMarquee />
    <Grant />
    <WriteGate />
    <Activity />
    <Screens />
    <Latency />
    <BodySearch />
    <SafariPages />
    <Surfaces />
    <Status />
    <Pricing />
    <Cta />
  </main>
  <Footer />
</Layout>
