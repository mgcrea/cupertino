{
  "$schema": "node_modules/wrangler/config-schema.json",
  "account_id": "0121e8859874c6fc0d674676e17d9f18",
  "name": "cupertino-api",
  "main": "./src/index.ts",
  "compatibility_date": "2026-03-31",
  "routes": [{ "pattern": "api.cupertino.mgcrea.io", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cupertino-licenses",
      // From `wrangler d1 create cupertino-licenses`. Only the remote binding
      // needs it; `--local` keys on the name, so miniflare ignores this value.
      "database_id": "650f4f59-f793-428d-a4dc-76845995a511",
      "migrations_dir": "./migrations"
    }
  ],
  "vars": {
    "CURRENT_MAJOR": "1",
    "LICENSE_FROM_EMAIL": "Cupertino <licences@mgcrea.io>",
    "SITE_URL": "https://cupertino.mgcrea.io"
  },
  "send_metrics": false,
  "workers_dev": false,
  "preview_urls": false
}
