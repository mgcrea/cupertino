{
  "manifest_version": 3,
  "name": "Cupertino",
  "version": "1.6.0",
  "description": "Lets Cupertino read the page you are looking at, on the websites you allow.",

  "background": { "service_worker": "background.js" },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["actions.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],

  "action": {
    "default_title": "Cupertino",
    "default_icon": {
      "48": "images/icon-48.png",
      "96": "images/icon-96.png",
      "128": "images/icon-128.png",
      "256": "images/icon-256.png",
      "512": "images/icon-512.png"
    }
  },

  "icons": {
    "48": "images/icon-48.png",
    "96": "images/icon-96.png",
    "128": "images/icon-128.png",
    "256": "images/icon-256.png",
    "512": "images/icon-512.png"
  },

  "permissions": ["nativeMessaging"]
}
