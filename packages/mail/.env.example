# ── Safety ───────────────────────────────────────────────────────────────────
# Register the mutating tools (flag / move / delete / send). Off by default.
# With it off they are not merely refused — they are never registered, so the
# model cannot see or call them at all.
# APPLE_MAIL_ALLOW_WRITES=1

# ── Context cost ─────────────────────────────────────────────────────────────
# Register the workflow prompts (apple_mail_triage, apple_mail_find_thread,
# apple_mail_draft_reply) and the cupertino://mail/{guide,diagnostics,inventory}
# resources. ON by default — this is a COST knob, not a safety gate, which is
# the whole reason its default is the opposite of ALLOW_WRITES.
#
# What it costs, measured across all seven servers with writes on: the prompt
# and resource LISTINGS come to ~3.4k tokens against ~18.5k for the tool
# definitions. Resource contents cost nothing until something reads one, and one
# prompt expansion is ~950 tokens, most of it the guide it embeds. Turn this off
# if a host puts every listing in the prompt and you are counting bytes — but
# running fewer servers is the much bigger lever.
# APPLE_MAIL_EXPOSE_PROMPTS=0

# Restrict which accounts this server can see AT ALL. Comma-separated display
# names or UUIDs; empty means every account.
#
# ALLOW_WRITES gates mutation, but the bigger exposure here is *reading* a whole
# mail archive — this is the control for that, and it is enforced in one place
# so no query path can get around it.
# APPLE_MAIL_ACCOUNTS=iCloud,Work

# ── Discovery ────────────────────────────────────────────────────────────────
# Both are normally discovered: Mail reports its own data directory over Apple
# Events, which works even without Full Disk Access. Set these only for tests,
# a forensic copy, or a non-standard layout.
# APPLE_MAIL_ROOT=/Users/you/Library/Mail/V10
# APPLE_MAIL_ENVELOPE_INDEX=/Users/you/Library/Mail/V10/MailData/Envelope Index

# How to open Mail's search index:
#   auto      try mode=ro, fall back to immutable=1   (default)
#   ro        read-only, WAL-aware — sees mail that has not been checkpointed
#   immutable skips the -wal file: FASTER BUT CAN SILENTLY HIDE RECENT MAIL
#   off       disable the index lane entirely (privacy / troubleshooting)
# APPLE_MAIL_INDEX_MODE=auto

# ── Budgets ──────────────────────────────────────────────────────────────────
# Apple Events are slow: about 130ms of overhead plus 42ms per message per
# field. These caps exist so a large request fails visibly instead of hanging.
# APPLE_MAIL_DEGRADED_MAX_MESSAGES=50
# APPLE_MAIL_MAX_RESULTS=200
# APPLE_MAIL_BODY_MAX_BYTES=262144

# The first Automation attempt blocks on a permission dialog until the user
# answers it, which is why this is 30s and not 5s.
# APPLE_MAIL_OSASCRIPT_TIMEOUT_MS=30000
# APPLE_MAIL_MAILBOX_CACHE_TTL_MS=60000

# The only directory attachments may be written to, enforced after realpath.
# APPLE_MAIL_ATTACHMENT_DIR=/Users/you/Downloads

# ── Debug ────────────────────────────────────────────────────────────────────
# APPLE_MAIL_DEBUG=1
