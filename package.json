{
  "name": "@mgcrea/cupertino",
  "version": "1.13.0",
  "private": true,
  "description": "MCP servers for the Apple apps on your Mac, and the signed app that grants them one permission",
  "license": "MIT",
  "author": "Olivier Louvignes <olivier@mgcrea.io>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mgcrea/cupertino.git"
  },
  "os": [
    "darwin"
  ],
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test && pnpm test:scripts",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\"",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "probe:mail": "node scripts/probe-envelope-index.mjs",
    "probe:mail-body": "node scripts/probe-mail-body.mjs",
    "probe:notes": "node scripts/probe-notes.mjs",
    "probe:reminders": "node scripts/probe-reminders.mjs",
    "probe:messages": "node scripts/probe-chat-db.mjs",
    "probe:calendar": "node scripts/probe-calendar.mjs",
    "probe:contacts": "node scripts/probe-contacts.mjs",
    "probe:safari": "node scripts/probe-safari.mjs",
    "probe:stickies": "node scripts/probe-stickies.mjs",
    "probe:maps": "node scripts/probe-maps.mjs",
    "probe:maps-write": "node scripts/probe-maps-write.mjs",
    "probe:home": "node scripts/probe-home.mjs",
    "probe:passwords": "node scripts/probe-passwords.mjs",
    "probe:screen": "swift scripts/probe-screen.swift",
    "probe:sound": "swift scripts/probe-sound.swift",
    "version:sync": "node scripts/generate-version.mjs",
    "version:check": "node scripts/generate-version.mjs --check"
  },
  "devDependencies": {
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "tsdown": "^0.22.14"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.13.1"
}
