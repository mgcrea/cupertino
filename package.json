{
  "name": "@mgcrea/cupertino",
  "version": "0.0.0",
  "private": true,
  "description": "MCP servers for the Apple apps on your Mac, and the signed app that grants them one permission",
  "license": "MIT",
  "author": "Olivier Louvignes <olivier@mgcrea.io>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mgcrea/mcp-apple-mail.git"
  },
  "os": [
    "darwin"
  ],
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "probe:mail": "node scripts/probe-envelope-index.mjs",
    "probe:notes": "node scripts/probe-notes.mjs",
    "probe:reminders": "node scripts/probe-reminders.mjs"
  },
  "devDependencies": {
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.13.1"
}
