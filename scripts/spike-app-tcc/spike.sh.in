#!/bin/sh
# Runs INSIDE the spike bundle, spawned by the app's main executable.
#
# Everything here is a child of the .app, which is the entire point: the real
# design never touches Mail from Swift, it spawns `node cli.js` and
# `/usr/bin/osascript` and relies on them inheriting the app's identity.
#
# build.sh substitutes @NODE@ and @REPO@ — Finder launches an app with a bare
# PATH, so a Homebrew node would not otherwise be found.

set -u

NODE="@NODE@"
REPO="@REPO@"

echo "child PATH=$PATH"
echo "child pid=$$ ppid=$PPID"

# --- Lane 1: the file lane, via a node child (reuses scripts/fda-probe.mjs) ---
echo
echo "--- file lane: node $REPO/scripts/fda-probe.mjs"
if [ -x "$NODE" ]; then
  "$NODE" "$REPO/scripts/fda-probe.mjs"
  file_rc=$?
  echo "file lane rc=$file_rc  (0 = readable, 3 = denied)"
else
  echo "file lane SKIPPED: no node at $NODE"
  file_rc=127
fi

# --- Lane 2: the Apple Events lane, via /usr/bin/osascript ---
# The liveness gate mirrors packages/mail/src/client/jxa/core.ts: never send an
# Apple Event to an app that is not running, because that launches it.
echo
echo "--- apple events lane: /usr/bin/osascript -l JavaScript"
/usr/bin/osascript -l JavaScript <<'JXA'
ObjC.import('AppKit');
const running = (bundleId) =>
  $.NSRunningApplication.runningApplicationsWithBundleIdentifier(bundleId).count > 0;

const probe = (bundleId, name, fn) => {
  if (!running(bundleId)) return { app: name, skipped: 'not running' };
  try {
    return { app: name, ok: true, sample: fn() };
  } catch (err) {
    return { app: name, ok: false, error: String(err) };
  }
};

const out = [
  probe('com.apple.mail', 'Mail', () => Application('Mail').accounts().length),
  probe('com.apple.Notes', 'Notes', () => Application('Notes').accounts().length),
];
JSON.stringify(out, null, 2);
JXA
ae_rc=$?
echo "apple events lane rc=$ae_rc"

# --- Lane 2b: Accessibility, the grant the first run of this spike never asked about ---
#
# The original spike measured Full Disk Access and Apple Events, found both
# inherited, and the codebase generalised that to "everything the app spawns
# inherits its identity". Accessibility was never in the experiment, and it is
# the grant a Mail composer needs. It does inherit — but a day was lost to a
# machine where the app reported AXIsProcessTrusted true and its grandchild
# reported false, because the identifier held four separate Accessibility
# entries at once (README: "One identifier, four grants"). This lane exists so
# that state is visible instead of inferred.
#
# TWO answers, deliberately, because they can disagree:
#   trusted  — what the flag claims about this process's identity
#   uiRead   — whether another app's windows can actually be named
# The second is the one that decides whether a reply works.
echo
echo "--- accessibility lane: /usr/bin/osascript -l JavaScript (grandchild)"
/usr/bin/osascript -l JavaScript <<'JXA'
ObjC.import('AppKit');
ObjC.import('ApplicationServices');

var trusted = 'error';
try { trusted = $.AXIsProcessTrusted() ? 'granted' : 'denied'; } catch (e) { trusted = 'throw ' + e; }

var SE = Application('System Events');
var systemEvents = 'error', uiRead = 'error', windows = null;
try { SE.processes.name(); systemEvents = 'granted'; }
catch (e) { systemEvents = 'denied: ' + (e.message || e); }

// Finder rather than Mail: it is always running, so an empty answer here means
// blind rather than "nothing open".
try {
  windows = SE.processes.byName('Finder').windows().map(function (w) {
    try { return w.name(); } catch (e) { return null; }
  });
  uiRead = 'granted (' + windows.length + ' Finder windows)';
} catch (e) {
  uiRead = 'denied: ' + (e.message || e);
}

JSON.stringify({ trusted: trusted, systemEvents: systemEvents, uiRead: uiRead }, null, 2);
JXA
ax_rc=$?
echo "accessibility lane rc=$ax_rc"

# --- Lane 2c: Screen Recording, the grant the proposed `screen` surface needs ---
#
# A THIRD service, measured rather than inherited. This spike found FDA and
# Apple Events both inherit, the codebase generalised that to every TCC service,
# and Accessibility proved the generalisation false (README: "One identifier,
# four grants"). Screen Recording gets its own lane for the same reason.
#
# The probe reports its own blindness first and refuses to report a negative it
# cannot stand behind — it exits 3 for UNDETERMINED rather than printing "no
# capture lane", which is the mistake docs/surfaces.md records being made three
# times about the Maps store.
echo
echo "--- screen recording lane: probe-screen (child of the app)"
here=$(cd "$(dirname "$0")" && pwd)
if [ -x "$here/probe-screen" ]; then
  "$here/probe-screen" --surfaces="$REPO/surfaces.json" --out="$HOME/Library/Logs/cupertino-spike-shots"
  screen_rc=$?
  echo "screen lane rc=$screen_rc  (0 = GO, 3 = undetermined, 4 = measured NO-GO)"
else
  echo "screen lane SKIPPED: no probe-screen in $here (rebuild with ./build.sh)"
  screen_rc=127
fi

# --- Lane 3: the REAL code path, not a toy probe ---
# scripts/probe-envelope-index.mjs is the phase-0 spike that produced
# docs/envelope-index.md. Its output is redacted by design (DDL, counts,
# timings only), so it is safe to run here. If this works as a child of the
# app, the index lane works under the app-hosted design.
echo
echo "--- real code path: probe-envelope-index.mjs"
if [ -x "$NODE" ]; then
  "$NODE" "$REPO/scripts/probe-envelope-index.mjs" 2>&1 | head -30
  echo "real probe rc=${?}"
else
  echo "SKIPPED: no node at $NODE"
fi

echo
echo "summary: file_lane_rc=$file_rc apple_events_rc=$ae_rc accessibility_rc=$ax_rc screen_rc=$screen_rc"
[ "$file_rc" -eq 0 ] || exit 3
exit 0
