# ── Licence signing ──────────────────────────────────────────────────────────
# The Ed25519 keypair every licence key is signed with. Generate it once, with
#
#   node scripts/mint-license.mjs --keygen
#
# and never again for this major version: the public half is compiled into the
# app, so a new keypair refuses every key already issued.
#
# The private half is the only secret in the whole scheme, and it fails in both
# directions. Leak it and anyone can issue keys. Lose it and no key can ever be
# issued for this major version again — including a replacement for a customer
# who lost theirs. Back it up somewhere that is not this machine and not the
# Worker it also lives in.
#
# LICENSE_SIGNING_KEY=<PKCS#8 DER, base64 — 64 chars>

# The public half. Not a secret; it only ever verifies. Kept here so
# scripts/verify-license.mjs can check a key against a keypair other than the
# one compiled in — normally it needs neither, because PUBLIC_KEY in
# scripts/lib/license.mjs is the shipped value.
#
# LICENSE_SIGNING_KEY_PUBLIC=<raw 32 bytes, base64url — 43 chars>
